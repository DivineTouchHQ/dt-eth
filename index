<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Divine Touch</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      width: 100%;
      min-height: 100%;
      background: #000;
    }

    body {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;

      font-family: "Courier New", Courier, monospace;
      overflow-x: hidden;
    }

    .landing {
      width: 100%;
      min-height: 100vh;

      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;

      padding: 32px 20px;
    }

    .art-link {
      display: block;
      width: min(76vw, 760px);

      text-decoration: none;
      cursor: pointer;
    }

    .artwork {
      display: block;

      width: 100%;
      max-height: 72vh;

      object-fit: contain;

      background: #000;

      user-select: none;
      -webkit-user-drag: none;
    }

    .tagline {
      margin-top: 24px;

      color: #39ff14;

      font-size: clamp(14px, 1.6vw, 20px);
      font-weight: 400;

      letter-spacing: 0.02em;
      text-align: center;
      line-height: 1.4;
    }

    @media (max-width: 700px) {
      .landing {
        padding: 24px 16px;
      }

      .art-link {
        width: 92vw;
      }

      .artwork {
        max-height: 68vh;
      }

      .tagline {
        margin-top: 18px;
        font-size: 14px;
      }
    }
  </style>
</head>

<body>

  <main class="landing">

    <a
      class="art-link"
      href="/1inus"
      aria-label="Enter The One in Us"
    >
      <img
        id="cycling-artwork"
        class="artwork"
        src="https://raw.githubusercontent.com/DivineTouchHQ/dt-eth/main/the-one-in-us-art/cuban-link.jpg"
        alt="The One in Us"
      />
    </a>

    <p class="tagline">
      The Home of Handcrafted Collector Package NFTs
    </p>

  </main>

  <script>
    const base =
      "https://raw.githubusercontent.com/DivineTouchHQ/dt-eth/main/the-one-in-us-art/";

    const artworks = [
      base + "cuban-link.jpg",
      base + "divine.jpg",
      base + "galactic.jpg",
      base + "goldmouth.jpg",
      base + "grassy-knoll.jpg",
      base + "rasta.jpg",
      base + "the-artist.jpg",
      base + "the-cop.jpg",
      base + "the-durag.jpg",
      base + "the-fez.jpg",
      base + "the-fugitive.jpg",
      base + "the-original.jpg",
      base + "the-outsider.jpg",
      base + "the-player.jpg",
      base + "underwater.jpg"
    ];

    const artworkElement =
      document.getElementById("cycling-artwork");

    let currentArtwork = 0;

    // Preload all 15 artworks
    artworks.forEach((src) => {
      const image = new Image();
      image.src = src;
    });

    // Hard-cut to the next artwork every 0.3 seconds
    setInterval(() => {
      currentArtwork =
        (currentArtwork + 1) % artworks.length;

      artworkElement.src =
        artworks[currentArtwork];
    }, 300);
  </script>

</body>
</html>
