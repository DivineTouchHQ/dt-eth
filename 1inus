      {
        number: "15",
        name: "Divine",
        price: "0.55 ETH",
        collector: "",
        status: "available",
        purchaseLink: "#"
      }

    ];


    const ledger =
      document.getElementById("ledger");


    pieces.forEach((piece) => {

      const element =
        document.createElement(
          piece.status === "available"
            ? "a"
            : "div"
        );


      element.className =
        `piece ${piece.status}`;


      if (piece.status === "available") {

        element.href =
          piece.purchaseLink;

        element.target =
          "_blank";

        element.rel =
          "noopener noreferrer";

      }


      element.innerHTML = `

        <span class="number">
          ${piece.number}
        </span>

        <span class="name">
          ${piece.name}
        </span>

        <span class="price">
          ${piece.price}
        </span>

        <span class="collector">
          ${piece.collector}
        </span>

      `;


      ledger.appendChild(element);

    });

  </script>

</body>
</html>
