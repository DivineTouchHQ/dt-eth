        status: "owned"
      },

      {
        number: "11",
        name: "The Fugitive",
        price: "0.41 ETH",
        collector: "",
        status: "available",
        purchaseLink: "#"
      },

      {
        number: "12",
        name: "Underwater",
        price: "0.41 ETH",
