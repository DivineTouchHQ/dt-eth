<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Grassy Knoll — Divine Touch</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #000;
    }

    body {
      font-family: "Courier New", Courier, monospace;
      color: #39ff14;
    }

    .artifact-page {
      width: 100vw;
      height: 100vh;

      display: flex;
      align-items: center;
      justify-content: center;

      gap: clamp(35px, 7vw, 110px);
      padding: 40px;
    }

    .artwork {
      width: min(34vw, 420px);
      max-height: 70vh;

      object-fit: contain;
      display: block;
    }

    .info {
      width: min(38vw, 480px);

      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .name {
      font-size: clamp(24px, 3vw, 44px);
      font-weight: 400;
      margin-bottom: 22px;
      text-transform: uppercase;
    }

    .description {
      font-size: clamp(14px, 1.5vw, 20px);
      line-height: 1.5;
      margin-bottom: 24px;
    }

    .price {
      font-size: clamp(18px, 2vw, 28px);
    }

    @media (max-width: 700px) {
      .artifact-page {
        gap: 22px;
        padding: 20px;
      }

      .artwork {
        width: 44vw;
        max-height: 55vh;
      }

      .info {
        width: 42vw;
      }

      .name {
        font-size: 18px;
        margin-bottom: 14px;
      }

      .description {
        font-size: 12px;
        margin-bottom: 16px;
      }

      .price {
        font-size: 15px;
      }
    }
  </style>
</head>

<body>

  <main class="artifact-page">

    <img
      class="artwork"
      src="https://raw.githubusercontent.com/DivineTouchHQ/dt-eth/main/the-one-in-us-art/grassy-knoll.jpg"
      alt="Grassy Knoll"
    />

    <section class="info">

      <h1 class="name">
        Grassy Knoll
      </h1>

      <p class="description">
        The one in us that chases nostalgia.
      </p>

      <p class="price">
        0.19 ETH
      </p>

    </section>

  </main>

</body>
</html>
